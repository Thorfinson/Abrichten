# Abrichten — environment configuration
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# Loaded by Vite on startup (dev server / build). Values act as fallbacks;
# anything configured in the in-app Settings dialog takes precedence.

# OpenRouter API key for the AI assistant — https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Vision-capable model id (browse at https://openrouter.ai/models)
VITE_OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Optional: any OpenAI-compatible endpoint (defaults to OpenRouter)
# VITE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
